// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  support
  adjuster
  admin
}

enum QuoteStatus {
  draft
  calculated
  expired
  converted
}

enum PolicyStatus {
  active
  expired
  cancelled
  suspended
}

enum ClaimStatus {
  submitted
  in_review
  approved
  rejected
  settled
}

enum PaymentMethod {
  fpx
  duitnow
  card
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?
  fullName        String?
  verifiedAt      DateTime?
  role            UserRole  @default(customer)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  quotes          Quote[]
  policies        Policy[]
  auditLogs       AuditLog[]
}

model Quote {
  id              String      @id @default(cuid())
  userId          String?
  postcode        String
  ncdPercent      Float
  ncdSource       String?
  sstRate         Float
  sstAmount       Float
  pricingJson     Json
  status          QuoteStatus @default(draft)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  expiresAt       DateTime
  
  user            User?       @relation(fields: [userId], references: [id])
  drivers         Driver[]
  vehicles        Vehicle[]
  
  @@index([userId])
}

model Driver {
  id              String    @id @default(cuid())
  quoteId         String?
  policyId        String?
  fullName        String
  nricHash        String
  dob             DateTime
  licenseClass    String
  incidentsJson   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  quote           Quote?    @relation(fields: [quoteId], references: [id])
  policy          Policy?   @relation(fields: [policyId], references: [id])
  
  @@index([nricHash])
}

model Vehicle {
  id              String    @id @default(cuid())
  quoteId         String?
  policyId        String?
  plate           String
  vin             String?
  make            String
  model           String
  year            Int
  valuationValue  Float?
  usage           String
  ownership       String
  safetyJson      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  quote           Quote?    @relation(fields: [quoteId], references: [id])
  policy          Policy?   @relation(fields: [policyId], references: [id])
  
  @@index([plate])
}

model Policy {
  id                  String        @id @default(cuid())
  policyNo            String        @unique
  userId              String
  product             String
  sumInsuredType      String
  premiumTotal        Float
  jpjSubmissionStatus String?
  effectiveDate       DateTime
  expiryDate          DateTime
  status              PolicyStatus  @default(active)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  user                User          @relation(fields: [userId], references: [id])
  drivers             Driver[]
  vehicles            Vehicle[]
  endorsements        Endorsement[]
  claims              Claim[]
  payments            Payment[]
  documents           Document[]
  
  @@index([userId])
}

model Endorsement {
  id              String    @id @default(cuid())
  policyId        String
  diffJson        Json
  premiumDelta    Float
  status          String
  effectiveDate   DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  policy          Policy    @relation(fields: [policyId], references: [id])
}

model Claim {
  id              String      @id @default(cuid())
  policyId        String
  status          ClaimStatus @default(submitted)
  lossDate        DateTime
  policeReportNo  String?
  odKfkFlag       Boolean     @default(false)
  workshopType    String?
  description     String
  estimatedAmount Float?
  approvedAmount  Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  policy          Policy      @relation(fields: [policyId], references: [id])
  
  @@index([policyId, status])
}

model Payment {
  id              String        @id @default(cuid())
  policyId        String
  method          PaymentMethod
  amount          Float
  currency        String        @default("MYR")
  txnRef          String        @unique
  status          PaymentStatus @default(pending)
  ledgerJson      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  policy          Policy        @relation(fields: [policyId], references: [id])
}

model Document {
  id              String    @id @default(cuid())
  policyId        String
  type            String
  storageKey      String
  hash            String
  issuedAt        DateTime
  createdAt       DateTime  @default(now())
  
  policy          Policy    @relation(fields: [policyId], references: [id])
}

model AuditLog {
  id              String    @id @default(cuid())
  actorId         String?
  action          String
  entity          String
  entityId        String
  timestamp       DateTime  @default(now())
  metadataJson    Json?
  
  actor           User?     @relation(fields: [actorId], references: [id])
}