# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/motor_insurance_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Security
NRIC_SALT=your-nric-salt-here-change-in-production

# Email Service
EMAIL_FROM=noreply@motor-insurance.my
EMAIL_SERVICE=console # console | sendgrid | ses
SENDGRID_API_KEY=

# Feature Flags
NCD_REQUIRED=false
JPJ_SUBMIT_ENABLED=false
EKYC_REQUIRED_TIER=0
PSP=sandbox
PAYMENTS_SANDBOX=true

# External Services
NCD_API_URL=
NCD_API_KEY=
JPJ_API_URL=
JPJ_CERTIFICATE_PATH=
VALUATION_API_URL=
VALUATION_API_KEY=

# Malaysian Specific
SST_RATE=0.08

# AWS (if using AWS deployment)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Storage
S3_BUCKET_NAME=motor-insurance-documents
S3_ENDPOINT=

# Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=motor-my-api